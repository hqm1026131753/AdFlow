# Kimi / Moonshot AI
KIMI_API_KEY=sk-your-kimi-key
KIMI_BASE_URL=https://api.moonshot.cn/v1

# OpenAI / GPT Proxy (e.g. api.qch1.com)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Image Generation (BananaPro / Gemini)
IMAGE_GEN_API_KEY=sk-your-image-gen-key
IMAGE_GEN_BASE_URL=https://newapi.bananapro.top/v1

# Stock Photo APIs (for Ad Scout auto-search)
# Get free keys at:
#   Unsplash: https://unsplash.com/developers
#   Pexels:   https://www.pexels.com/api/
#   Pixabay:  https://pixabay.com/api/docs/
UNSPLASH_ACCESS_KEY=your-unsplash-access-key
PEXELS_API_KEY=your-pexels-api-key
PIXABAY_API_KEY=your-pixabay-api-key

# Social Platform APIs (optional, for legacy social search)
# FB_ACCESS_TOKEN=your-facebook-token
# PINTEREST_TOKEN=your-pinterest-token
# GOOGLE_API_KEY=your-google-key
# GOOGLE_CX=your-google-cx

# Server
PORT=3000
NODE_ENV=production
